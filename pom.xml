<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.qwertyhgb</groupId>
    <artifactId>knowflow</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>knowflow</name>
    <description>用于学习 Java 后端开发的知识库项目</description>
    <properties>
        <java.version>21</java.version>
        <!-- Spring AI 版本：统一管理 Spring AI 全家桶依赖版本。
             2.0.0 是官方 GA 稳定版（2026-06 发布），官方支持 Spring Boot 4.0.x / 4.1.x，
             与本项目的 Spring Boot 4.1.0 是官方匹配的版本组合，不用旧版 1.x。 -->
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!--
                Spring AI BOM（Bill of Materials）：以 import + pom 方式引入，统一管理
                Spring AI 全家桶各依赖的版本。与 Spring Boot BOM 同模式：
                让 Spring AI 各 starter 都共享同一个版本，避免手写每个 starter 的版本号、
                防止多依赖版本漂移导致的冲突。之后新加 spring-ai-* 依赖都不用写版本号。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Spring AMQP：Spring 生态操作 RabbitMQ 的标准入口，提供
             RabbitTemplate（发送/接收）、@RabbitListener（注解式消费）、
             自动配置（连接工厂、消息转换器等）。版本由 Spring Boot BOM 管理，不写版本号。
             引入理由：文档解析异步化——上传后发消息，消费者在后台解析，
             用户无需等待同步解析完成。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- Spring Data Elasticsearch：Spring 生态操作 Elasticsearch 的标准入口，提供
             ElasticsearchOperations 模板与 Repository 抽象，以及基于 @Document/@Field
             注解的自动配置（自动创建 Client 与索引操作 Bean）。版本由 Spring Boot BOM 管理，
             不写版本号。
             引入理由：文档全文搜索——MySQL 的 LIKE '%xxx%' 走全表扫描、无倒排索引，
             无法支撑关键词检索；解析完成的文档纯文本（document.content）需要进入 ES
             供后续搜索接口检索（Phase 8 第一步：本步只建索引模型与初始化，不建搜索接口）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI：官方 AI 集成框架，提供统一抽象的 ChatClient / ChatModel 等 Bean。
             这里用 OpenAI 模型的 starter（版本由上面的 spring-ai-bom 统一管理，不写版本号）。
             【为什么 OpenAI starter 能接 DeepSeek？】
             DeepSeek 对外提供 OpenAI 兼容的 /chat/completions API，格式与 OpenAI 完全一致，
             Spring AI 只需把 base-url 指向 DeepSeek 端点即可复用 OpenAI 适配器，无需专用 starter。
             这也是国内大模型生态的常见做法——几乎所有国产模型都提供 OpenAI 兼容层，
             移植成本极低，只用改 base-url 和模型名就能切换厂商。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Spring AI 的 Elasticsearch 向量存储 starter（版本由 spring-ai-bom 统一管理，不写版本号）。
             引入理由：Embedding 向量化后的落库与检索（Phase 10/11）。
             【为什么用 Spring AI 的 ES 向量存储抽象，而不是新引入专用向量数据库？】
             1. 项目已有 ES 9.4.2（Phase 8 全文搜索引入），它原生支持 dense_vector + kNN 检索，
                复用现有基础设施即可支撑向量语义检索，符合「已有技术能满足就不引入新技术」的教学原则；
             2. 该 starter 开箱即用：自动装配 VectorStore Bean + ElasticsearchVectorStore，
                且会自动创建带 dense_vector 字段的索引（用 spring.ai.vectorstore.elasticsearch.index-name
                配置索引名），无需手写 ES Mapping；
             3. VectorStore 是 Spring AI 的统一抽象接口（add/delete/similaritySearch），
                后续若要换向量库（如 Milvus/Qdrant），业务代码无需改动，只换 starter 与配置。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-elasticsearch</artifactId>
        </dependency>

        <!-- 数据库版本管理：Flyway 负责在应用启动时按序执行 db/migration 下的迁移脚本。
             Spring Boot 4 起 Flyway 自动配置移入独立的 starter，需显式引入。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10+ 将 MySQL 支持拆分为独立模块，需显式引入 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- PDFBox：PDF 文本提取库（org.apache.pdfbox.pdftext.PDFTextStripper）。
             PDF 是二进制格式，页面文本以对象/流形式内嵌，必须用专业解析库按结构读取，
             不能像 TXT/MD 那样直接读字节当文本。引入理由：文档解析把 PDF 内容提取为
             纯文本存入 document.content，作为后续搜索与 AI/RAG 的数据源。 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- Apache POI (poi-ooxml)：DOCX 文本提取库（org.apache.poi.xwpf.extractor.XWPFWordExtractor）。
             DOCX 本质是 zip 包的 OOXML 容器，文档正文分散在 XML 部件中，必须用 POI 解包提取；
             不能直接读字节或当作纯文本读取。引入理由：与 PDFBox 相同，为文档解析提供
             DOCX → 纯文本的提取能力（poi-ooxml 自带核心 poi 与 xmlbeans、log4j-api 等传递依赖）。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
